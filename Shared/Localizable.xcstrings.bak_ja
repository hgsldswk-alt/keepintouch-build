    },
    "backup.privacy": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份含已保存的号码、备注和合照，请存到私密位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份含已儲存的號碼、備註和合照，請存到私密位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups contain saved numbers, notes, and photos. Keep the file somewhere private."
          }
        }
      }
    },
    "backup.replace": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复会用备份替换本机的亲友、联系记录、合照和提醒设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原會用備份取代本機的親友、聯絡紀錄、合照和提醒設定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring replaces the people, contact entries, photos, and reminder settings on this device."
          }
        }
      }
    },
