    "backup.export-error": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份导出失败。请确认照片文件完整且储存空间充足。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份匯出失敗。請確認照片檔案完整且儲存空間充足。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't export the backup. Check that your photos are available and you have enough storage."
          }
        }
      }
    },
    "backup.invalid": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此备份。请选择完整的亲友联络提醒备份文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此備份。請選擇完整的親友聯絡提醒備份檔案。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read this backup. Choose a complete Keep Close backup file."
          }
        }
      }
    },
    "backup.preview": {
      "extractionState": "manual",
      "localizations": {
