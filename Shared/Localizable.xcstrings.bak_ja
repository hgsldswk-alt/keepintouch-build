      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果不允许任何 App 读取手机通话记录和微信记录。从本 App 拨出的电话接通后会自动记上；在别处联系过，回到首页点一下「刚联系过」即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蘋果不允許任何 App 讀取手機通話紀錄和微信紀錄。從本 App 撥出的電話接通後會自動記上；在別處聯絡過，回到首頁點一下「剛聯絡過」即可。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple doesn't let any app read your call history or chat logs. Calls you start here are logged when they connect; for anything else, tap Just Talked."
          }
        }
      }
    },
